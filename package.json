{
  "name": "analisa-petshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --port 3000\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && esbuild src/server/index.ts --platform=node --bundle --format=esm --outfile=dist-server/index.js --packages=external",
    "start": "node dist-server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "docker:build": "docker build -t analisa-petshop:latest .",
    "docker:run": "docker run -p 8090:8090 analisa-petshop:latest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "@tanstack/react-query": "^5.67.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "html2canvas-pro": "^1.5.8",
    "jose": "^5.9.6",
    "lucide-react": "^0.477.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^2.15.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
